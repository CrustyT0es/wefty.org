{
  "name": "Wefty 2.0 preview",
  "short_name": "Wefty 2.0 preview",
  "description": "Your notes, files and clipboard, on your phone and your PC.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0f0d1b",
  "theme_color": "#0f0d1b",
  "icons": [
    {
      "src": "icons/wefty-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/wefty-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/wefty-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/wefty-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/wefty-mono-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "monochrome"
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "*/*"
          ]
        }
      ]
    }
  },
  "shortcuts": [
    {
      "name": "New note",
      "url": "./#new",
      "icons": [
        {
          "src": "icons/wefty-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Send to PC",
      "url": "./#send",
      "icons": [
        {
          "src": "icons/wefty-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Send clipboard",
      "url": "./#clip",
      "icons": [
        {
          "src": "icons/wefty-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ]
}
